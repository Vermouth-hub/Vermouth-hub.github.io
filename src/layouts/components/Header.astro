---
import HeaderLink from './HeaderLink.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils';
import { SHOW_TAGS, SHOW_LINKS } from '../../consts';

const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].slice(0, 5);
const pathname = Astro.url.pathname;
const blogActive = pathname === '/posts/' || pathname.startsWith('/tags/') || posts.some((post) => pathname === `/${post.id}/`);
---

<header class='site-header' data-state='visible' data-scrolled='false'>
	<div class='site-nav'>
		<div class='site-nav__content'>
			<a href='/' class='site-brand' aria-label='Ve2m0uth home'>
				<span class='brand-mark' aria-hidden='true'>V</span>
				<span>Ve2m0uth</span>
			</a>

			<button class='mobile-menu-button' id='mobileMenuButton' aria-expanded='false' aria-controls='primaryNavigation'>
				<span class='sr-only'>Open navigation</span>
				<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden='true'>
					<path d='M4 7h16M4 12h16M4 17h16'></path>
				</svg>
			</button>

			<div class='navigation-shell' id='primaryNavigation'>
				<nav class='nav-links' aria-label='Main navigation'>
					<div class='blog-menu'>
						<a class:list={['nav-link', { 'is-active': blogActive }]} href='/posts/'>
							Blog
							<svg width='12' height='12' viewBox='0 0 12 12' fill='none' stroke='currentColor' stroke-width='1.4' aria-hidden='true'
								><path d='m3 4.5 3 3 3-3'></path></svg
							>
						</a>
						<div class='blog-dropdown'>
							<a href='/posts/'>All posts</a>
							{SHOW_TAGS && tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>{tag}</a>)}
						</div>
					</div>
					<HeaderLink href='/academic/'>Academic</HeaderLink>
					<HeaderLink href='/projects/'>Projects</HeaderLink>
					<HeaderLink href='/about/'>About</HeaderLink>
					{SHOW_LINKS && <HeaderLink href='/links/'>Links</HeaderLink>}
				</nav>

				<div class='nav-actions'>
					<a class='icon-button' href='https://github.com/Vermouth-hub' target='_blank' rel='noopener noreferrer' aria-label='GitHub profile'>
						<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden='true'
							><path
								d='M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4'
							></path><path d='M8 19c-3 .9-3-1.5-4.2-2'></path></svg
						>
					</a>
					<button class='icon-button' id='themeToggle' aria-label='Toggle color theme'>
						<svg
							class='sun'
							width='18'
							height='18'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='1.7'
							aria-hidden='true'
							><circle cx='12' cy='12' r='4'></circle><path
								d='M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'
							></path></svg
					>
					<svg
						class='moon'
						width='18'
						height='18'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='1.7'
						aria-hidden='true'><path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path></svg
					>
					</button>
				</div>
			</div>
		</div>
	</div>

	<script>
		import { setupNavbarVisibility } from '../../navbarVisibility';

		const header = document.querySelector<HTMLElement>('.site-header');
		const toggle = document.getElementById('themeToggle');
		const menuButton = document.getElementById('mobileMenuButton');
		const navigation = document.getElementById('primaryNavigation');
		const blogMenu = document.querySelector<HTMLElement>('.blog-menu');
		const navbarVisibility = header
			? setupNavbarVisibility(header, {
					isInteractionOpen: () =>
						menuButton?.getAttribute('aria-expanded') === 'true' ||
						Boolean(blogMenu?.matches(':hover, :focus-within'))
				})
			: null;

		toggle?.addEventListener('click', () => {
			const dark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		});
		menuButton?.addEventListener('click', () => {
			const open = menuButton.getAttribute('aria-expanded') !== 'true';
			menuButton.setAttribute('aria-expanded', String(open));
			navigation?.classList.toggle('is-open', open);
			navbarVisibility?.show();
		});
		blogMenu?.addEventListener('pointerenter', () => navbarVisibility?.show());
		blogMenu?.addEventListener('focusin', () => navbarVisibility?.show());
	</script>
</header>
