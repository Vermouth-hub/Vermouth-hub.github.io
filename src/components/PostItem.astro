---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type BlogPost = CollectionEntry<'blog'>;
interface Props { post: BlogPost; }
const { post } = Astro.props;
const words = (post.body ?? '').trim().split(/\s+/).length;
const minutes = Math.max(1, Math.ceil(words / 220));
const coverImage = post.data.coverImage;
---

<article class:list={['post-item', { 'has-cover': Boolean(coverImage) }]}>
	{coverImage && <div class='post-cover' aria-hidden='true'><img src={typeof coverImage === 'string' ? coverImage : coverImage.src} alt='' loading='lazy' /></div>}
	<div class='post-main'>
		<div class='post-date'><FormattedDate date={post.data.pubDate} /></div>
		<h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
		{post.data.description && <p>{post.data.description}</p>}
		<div class='post-reading-time'>
			<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true'><circle cx='12' cy='12' r='9'></circle><path d='M12 7v5l3 2'></path></svg>
			<span>{minutes} min read</span>
		</div>
		<div class='post-meta'>{(post.data.tags ?? []).map((tag) => <a href={`/tags/${slugify(tag)}/`}>{tag}</a>)}</div>
	</div>
	<span class='post-arrow' aria-hidden='true'>›</span>
</article>
