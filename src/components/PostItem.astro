---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { SHOW_TAGS } from '../consts';

type BlogPost = CollectionEntry<'blog'>;
interface Props {
	post: BlogPost;
}
const { post }: Props = Astro.props;

const coverImage = post.data.coverImage;
---

<article class='post-item group' data-reveal data-tilt>
	<div class='post-content flex flex-col gap-2'>
		<div class='text-zinc-500 text-xs dark:text-zinc-400'>
			<FormattedDate date={post.data.pubDate} />
		</div>

		<h3 class='text-xl font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors duration-200'>
			<a href={`/${post.id}/`} class='after:absolute after:inset-0 after:z-0'>
				{post.data.title}
			</a>
		</h3>

		{post.data.description && <p class='text-[var(--muted)] text-sm line-clamp-1'>{post.data.description}</p>}

		{
			SHOW_TAGS && (
				<div class='flex flex-wrap gap-2 mt-2 relative z-20'>
					{(post.data.tags || []).map((tag: string) => (
						<a href={`/tags/${slugify(tag)}`} class='tag-link'>
							{tag}
						</a>
					))}
				</div>
			)
		}
	</div>
	{
		coverImage && (
			<div class='post-cover' aria-hidden='true'>
				<img src={typeof coverImage === 'string' ? coverImage : coverImage.src} alt='' />
			</div>
		)
	}
</article>
