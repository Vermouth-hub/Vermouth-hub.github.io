---
interface TocItem {
	id: string;
	label: string;
	depth?: number;
}

interface Props {
	headings?: Array<{ depth: number; slug: string; text: string }>;
	items?: TocItem[];
	maxLevel?: number;
}

const { headings = [], items = [], maxLevel = 3 } = Astro.props;
const tocItems: TocItem[] = items.length
	? items
	: headings
			.filter((heading) => heading.depth >= 2 && heading.depth <= maxLevel)
			.map((heading) => ({ id: heading.slug, label: heading.text, depth: heading.depth }));
---

<details class='table-of-contents' data-page-toc open>
	<summary>On this page</summary>
	<nav aria-label='Table of contents'>
		<ul class='toc-list'>
			{
				tocItems.map((item) => (
					<li class:list={{ 'toc-subitem': (item.depth ?? 2) > 2 }}>
						<a href={`#${item.id}`} data-toc-link>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</details>

<script>
	import { getActiveTocIndex } from '../../lib/toc-scroll.mjs';

	const setupToc = (toc: HTMLDetailsElement) => {
		if (toc.dataset.ready === 'true') return;
		toc.dataset.ready = 'true';
		const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
		const targets = links
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((target): target is HTMLElement => Boolean(target));
		if (!targets.length) return;
		const compactLayout = window.matchMedia('(max-width: 1024px)');
		const syncDisclosure = (event: MediaQueryList | MediaQueryListEvent) => {
			if (event.matches) toc.removeAttribute('open');
			else toc.setAttribute('open', '');
		};
		syncDisclosure(compactLayout);
		compactLayout.addEventListener('change', syncDisclosure);

		const activate = () => {
			const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
			const currentIndex = getActiveTocIndex(
				targets.map((target) => target.getBoundingClientRect().top),
				window.innerHeight,
				atBottom
			);
			const current = targets[currentIndex] ?? targets[0];
			for (const link of links) {
				const active = decodeURIComponent(link.hash.slice(1)) === current.id;
				link.classList.toggle('is-active', active);
				if (active) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			}
		};

		let scheduled = false;
		const scheduleActivate = () => {
			if (scheduled) return;
			scheduled = true;
			requestAnimationFrame(() => {
				activate();
				scheduled = false;
			});
		};
		window.addEventListener('scroll', scheduleActivate, { passive: true });
		window.addEventListener('resize', scheduleActivate, { passive: true });
		window.addEventListener('load', scheduleActivate, { once: true });
		window.addEventListener('hashchange', activate);
		activate();
	};

	document.querySelectorAll<HTMLDetailsElement>('[data-page-toc]').forEach(setupToc);
</script>
