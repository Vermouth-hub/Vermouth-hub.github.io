---
import { projects, type Project } from '../data/projects';

const accentByType = {
	Research: 'cyan',
	Project: 'blue',
	Paper: 'violet',
	Article: 'orange',
	Writing: 'blue'
} as const;

function getTimelineType(project: Project) {
	return project.timelineType ?? (project.tags?.includes('Research') ? 'Research' : 'Project');
}
---

<section class='growth-tree-section' aria-labelledby='growth-tree-title'>
	<div class='growth-tree-heading' data-reveal>
		<div>
			<p class='section-kicker'>Growth record</p>
			<h2 id='growth-tree-title'>A research tree in progress</h2>
		</div>
		<p>Every branch is generated from the selected work record: research, papers, projects, and posts.</p>
	</div>

	<div class='growth-tree'>
		<div class='growth-tree-glow growth-tree-glow--one' aria-hidden='true'></div>
		<div class='growth-tree-glow growth-tree-glow--two' aria-hidden='true'></div>
		<svg class='growth-tree-trunk' viewBox='0 0 100 1000' preserveAspectRatio='none' aria-hidden='true' focusable='false'>
			<defs>
				<linearGradient id='growth-tree-gradient' x1='0' x2='1' y1='0' y2='1'>
					<stop offset='0' stop-color='#58a6ff'></stop>
					<stop offset='0.48' stop-color='#32c7b5'></stop>
					<stop offset='1' stop-color='#9b7bff'></stop>
				</linearGradient>
			</defs>
			<path d='M50 0 C36 110 64 184 48 296 S63 484 50 590 S37 786 52 1000' pathLength='1'></path>
		</svg>

		<ol class='growth-tree-list'>
			{
				projects.map((project, index) => {
					const type = getTimelineType(project);
					const accent = accentByType[type];
					const isExternal = /^https?:\/\//.test(project.demoLink);

					return (
						<li
							class:list={['tree-node', `tree-node--${index % 2 === 0 ? 'left' : 'right'}`, `tree-node--${accent}`]}
							data-reveal
							style={`--tree-node-index: ${index};`}
						>
							<span class='tree-node-branch' aria-hidden='true' />
							<span class='tree-node-marker' aria-hidden='true'>
								<i />
							</span>
							<article class='tree-card'>
								<div class='tree-card-meta'>
									<span class='tree-card-type'>{type}</span>
									<time>{project.timelineDate ?? 'Selected work'}</time>
								</div>
								<h3>{project.name}</h3>
								{project.description && <p>{project.description}</p>}
								<a
									class='tree-card-link'
									href={project.demoLink}
									target={isExternal ? '_blank' : undefined}
									rel={isExternal ? 'noopener noreferrer' : undefined}
								>
									{project.linkLabel} <span aria-hidden='true'>{isExternal ? '↗' : '→'}</span>
								</a>
							</article>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>
