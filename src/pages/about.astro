---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageViews from '../components/PageViews.astro';
import { profile } from '../data/profile';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const tocItems = [
	{ id: 'biography', label: 'Biography' },
	{ id: 'writing', label: 'Why this blog exists' },
	{ id: 'topics', label: 'Topics' },
	{ id: 'contact', label: 'Contact' }
];
---

<BaseLayout title={`About · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<PageShell tocItems={tocItems} contentClass='about-content'>
		<header id='biography' class='page-header about-header'>
			<p class='eyebrow'>About</p>
			<h2>Hi, I’m {profile.name}.</h2>
			<PageViews />
			<p>{profile.intro}</p>
		</header>

		<section id='writing' class='content-section text-section'>
			<h2>Why this blog exists</h2>
			<div class='about-copy-card card card-interactive'>
				<p>{profile.exists_reason}</p>
			</div>
		</section>

		<section id='topics' class='content-section'>
			<h2>Topics</h2>
			<div class='topic-list'>{profile.topics.map((topic) => <span>{topic}</span>)}</div>
		</section>

		<section id='contact' class='content-section contact-section'>
			<h2>Contact</h2>
			<p class='contact-copy'>
				If you would like to contact me on the field of LLM4SE, LLM security, or cybersecurity, feel free to reach out.
			</p>
			<nav class='contact-links' aria-label='Contact links'>
				<a href={`mailto:${profile.email}`} aria-label={`Email ${profile.email}`}>
					<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden='true'>
						<rect x='3' y='5' width='18' height='14' rx='2'></rect>
						<path d='m3 7 9 6 9-6'></path>
					</svg>
					<span>Email</span>
				</a>
				<a href={profile.github} target='_blank' rel='noopener noreferrer' aria-label='GitHub profile'>
					<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden='true'>
						<path d='M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4'></path>
						<path d='M8 19c-3 .9-3-1.5-4.2-2'></path>
					</svg>
					<span>GitHub</span>
				</a>
			</nav>
		</section>
	</PageShell>
</BaseLayout>
