---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={`${profile.name} - About`} description={SITE_DESCRIPTION}>
	<div class='container'>
		<article class='about-page'>
			<header class='about-page-header' data-reveal>
				<p class='section-kicker'>About</p>
				<h1>{profile.name}</h1>
				<p class='about-lead'>{profile.intro}</p>
			</header>

			<section class='about-section' data-reveal>
				<p class='about-index'>Research</p>
				<div>
					<h2>LLM4SE, LLM Agents, and Cybersecurity</h2>
					<p>{profile.research}</p>
					<!-- <p>我希望继续探索具备语义理解、搜索规划与环境反馈能力的可靠智能体，让模型能够更稳健地分析、复现和处理真实软件问题。</p> -->
					<a class='research-link' href={profile.arxiv} target='_blank' rel='noopener noreferrer'>TreeMind on arXiv <span aria-hidden='true'>↗</span></a>
				</div>
			</section>

			<section class='about-section' data-reveal> 
				<p class='about-index'>Writing</p>
				<div>
					<h2>Research Process & Study Insights</h2>
					<p>{profile.writing}</p>
					<a class='research-link' href='/algorithm-summary/'>Read Study Notes <span aria-hidden='true'>→</span></a>
				</div>
			</section>

			<section class='about-section' data-reveal>
				<p class='about-index'>Contact</p>
				<div>
					<h2>Contact Me</h2>
					<p>For discussions on LLM4SE, LLM Agents, and Cybersecurity, feel free to reach out via email or GitHub.</p>
					<div class='link-row'>
						<a href={`mailto:${profile.email}`}>{profile.email}</a>
						<a href={profile.github} target='_blank' rel='noopener noreferrer'>GitHub</a>
					</div>
				</div>
			</section>
		</article>
	</div>
</BaseLayout>
