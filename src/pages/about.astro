---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutTree from '../components/AboutTree.astro';
import { profile } from '../data/profile';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={`${profile.name} - About`} description={SITE_DESCRIPTION}>
	<div class='container'>
		<article class='about-page'>
			<header class='about-page-header' data-reveal>
				<p class='section-kicker'>About</p>
				<h1>{profile.name}</h1>
				<p class='about-lead'>{profile.intro}</p>
			</header>

			<AboutTree />

			<section class='about-contact' data-reveal>
				<p class='section-kicker'>Stay connected</p>
				<div>
					<h2>Let's compare notes.</h2>
					<p>For discussions on LLM4SE, LLM Agents, and cybersecurity, feel free to reach out by email or GitHub.</p>
					<div class='link-row'>
						<a href={`mailto:${profile.email}`}>{profile.email}</a>
						<a href={profile.github} target='_blank' rel='noopener noreferrer'>GitHub <span aria-hidden='true'>↗</span></a>
					</div>
				</div>
			</section>
		</article>
	</div>
</BaseLayout>
