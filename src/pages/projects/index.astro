---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from '../../data/projects';

---

<BaseLayout
	title="Research & Writing - Ve2m0uth"
	description="TreeMind research and algorithm training notes by Ve2m0uth."
>
  <div class='container'>
    <div class="mb-10" data-reveal>
      <p class="section-kicker mb-4">Selected Work</p>
      <h1 class="text-3xl font-bold mb-2">Research & Writing</h1>
      <p class="text-[var(--muted)] text-lg">Here are some of my selected research works and algorithm training notes.</p>
    </div>
    <ProjectList projects={projects}/>
  </div>
</BaseLayout>
