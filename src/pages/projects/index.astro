---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from '../../data/projects';

---

<BaseLayout
	title="Projects - Ve2m0uth"
	description="Research, security and engineering projects by Ve2m0uth."
>
  <div class='container'>
    <div class="mb-10" data-reveal>
      <p class="section-kicker mb-4">portfolio</p>
      <h1 class="text-3xl font-bold mb-2">Research and Engineering Projects</h1>
      <p class="text-zinc-700 dark:text-zinc-300 text-lg">从 TreeMind 到 Web 工程与安全实践，这里放我真正写过、研究过、复盘过的项目。</p>
    </div>
    <ProjectList projects={projects}/>
  </div>
</BaseLayout>
