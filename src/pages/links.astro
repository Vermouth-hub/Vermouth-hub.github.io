---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import { profile } from '../data/profile';

const tocItems = [
	{ id: 'links-overview', label: 'Overview' },
	{ id: 'profile-links', label: 'Profile links' }
];
---

<BaseLayout title='Links · Ve2m0uth' description='Selected profile and research links for Ve2m0uth.'>
	<PageShell tocItems={tocItems}>
		<header id='links-overview' class='page-header'>
			<p class='eyebrow'>Directory</p>
			<h1>Links</h1>
			<p>A small directory of existing profile, research, and contact links.</p>
		</header>
		<div id='profile-links' class='link-list'>
			<a href={profile.github} target='_blank' rel='noopener noreferrer'><span>Code</span><strong>GitHub ↗</strong></a>
			<a href={profile.arxiv} target='_blank' rel='noopener noreferrer'><span>Research</span><strong>arXiv ↗</strong></a>
			<a href={`mailto:${profile.email}`}><span>Contact</span><strong>{profile.email}</strong></a>
		</div>
	</PageShell>
</BaseLayout>
