---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageViews from '../components/PageViews.astro';
import { profile } from '../data/profile';
import { publications } from '../data/academic';
import { SITE_TITLE } from '../consts';

const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
const tocItems = [
	{ id: 'about', label: 'About me' },
	{ id: 'interests', label: 'Research interests' },
	{ id: 'publications', label: 'Selected publications' },
	...years.map((year) => ({ id: `year-${year}`, label: `achievement-${year}`, depth: 3 }))
];
---
<BaseLayout title={`Academic · ${SITE_TITLE}`} description='Academic profile, research interests, and publications by Ve2m0uth.'>
	<PageShell tocItems={tocItems} contentClass='academic-content'>

		<header class='page-header'>
			<h2>Academic</h2>
			<PageViews />
		</header>

		<section id='about' class='academic-section academic-section--intro'>
			<h2>About me</h2>
			<p>{profile.intro}</p>
		</section>

		<section id='interests' class='academic-section'>
			<h2>Research interests</h2>

			<div class='interest-list'>
				{
					profile.researchInterests.map((interest) => (
						<article class='card card-interactive'>
							<h3>{interest.name}</h3>
							<p>{interest.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id='publications' class='academic-section'>
			<h2>Selected publications</h2>

			<div class='publication-list'>
				{
					publications.map((publication, index) => (
						<article
							id={publications.findIndex((item) => item.year === publication.year) === index ? `year-${publication.year}` : undefined}
							class='publication-item card card-interactive'
						>
							<div class='publication-year'>{publication.year}</div>

							<div>
								<div class='publication-status'>{publication.status}</div>
								<h3>{publication.title}</h3>
								<p class='authors'>{publication.authors}</p>
								<p class='venue'>{publication.venue}</p>
								<p>{publication.description}</p>

								<div class='publication-links'>
									{publication.links.map((link) => (
										<a href={link.href} target='_blank' rel='noopener noreferrer'>
											{link.label} ↗
										</a>
									))}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

	</PageShell>
</BaseLayout>
