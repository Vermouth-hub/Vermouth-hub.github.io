---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsByYear from '../../components/PostsByYear.astro';
import { slugify } from '../../utils';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];
---

<BaseLayout title='Blog · Ve2m0uth' description='Research notes, study insights, and technical writing by Ve2m0uth.'>
	<main class='container reading-container'>
		<header class='page-header'>
			<p class='eyebrow'>Research & technical notes</p>
			<h1>Blog</h1>
			<p>Notes from research, software security, algorithms, and the practical details worth keeping.</p>
		</header>

		<div class='blog-toolbar'>
			<p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
			<div class='tag-row'>
				{
					tags.map((tag) => (
						<a class='tag-link' href={`/tags/${slugify(tag)}/`}>
							{tag}
						</a>
					))
				}
			</div>
		</div>

		<PostsByYear posts={posts} />
	</main>
</BaseLayout>
