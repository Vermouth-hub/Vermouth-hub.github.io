---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<main class='container reading-container'>
		<section class='home-intro'>
			<p class='eyebrow'>Information Security · LLM for Software Engineering</p>
			<h1>Research notes, software security, and the work behind them.</h1>
			<p class='lead'>{profile.intro}</p>
			<div class='inline-actions'>
				<a class='button primary' href='/academic/'>Academic profile</a>
				<a class='button' href='/posts/'>Read the blog</a>
			</div>
		</section>

		<section class='content-section'>
			<header class='section-header'>
				<div><p class='eyebrow'>Latest writing</p><h2>Recent posts</h2></div>
				<a class='text-link' href='/posts/'>View all <span aria-hidden='true'>→</span></a>
			</header>
			<div class='post-list'>{posts.map((post) => <PostItem post={post} />)}</div>
		</section>
	</main>
</BaseLayout>
