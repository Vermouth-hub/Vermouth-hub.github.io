---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
---

<BaseLayout title={SITE_TITLE + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<section class='hero-shell research-hero grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center mb-14' data-hero>
			<div class='text-pretty'>
				<p class='eyebrow'>Software Engineering / LLM Agents</p>
				<h1 class='hero-title mb-5'>
					<span class='hero-name'>{profile.name}</span>
					<span class='hero-direction'>{profile.direction}</span>
				</h1>
				<div class='hero-copy'>
					<p>{profile.intro}</p>
					<p>{profile.writing}</p>
				</div>
				<div class='mt-7 flex flex-wrap gap-3'>
					<a class='action-link primary' data-magnetic href={profile.arxiv} target='_blank' rel='noopener noreferrer'>TreeMind Paper</a>
					<a class='action-link' data-magnetic href='/algorithm-summary/'>Algorithm Notes</a>
				</div>
			</div>

			<aside class='research-brief'>
				<p class='section-kicker'>Current Research</p>
				<h2>TreeMind</h2>
				<p>{profile.research}</p>
				<div class='research-meta'>
					<span>Android</span>
					<span>LLM</span>
					<span>MCTS</span>
				</div>
				<a class='research-link' href={profile.arxiv} target='_blank' rel='noopener noreferrer'>Read on arXiv <span aria-hidden='true'>↗</span></a>
			</aside>
		</section>

		<main>
			<section class='work-section' data-reveal>
				<div class='section-heading'>
					<div>
						<p class='section-kicker'>Selected Work</p>
						<h2>Research & Writing</h2>
					</div>
				</div>
				<ProjectList projects={projects}/>
			</section>
		</main>
	</div>
</BaseLayout>
